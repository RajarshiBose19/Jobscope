# Copy to .env and fill in your details.

# LinkedIn credentials
LINKEDIN_USERNAME=you@example.com
LINKEDIN_PASSWORD=changeme

# Gemini API keys — comma-separated. Client rotates on rate limit (429).
# Get free keys at https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=AIza...,AIza...,AIza...

# Candidate profile — used by Gemini to score job fit
FULL_NAME=Your Name
PHONE=9999999999
CURRENT_CITY=Bengaluru
CURRENT_CTC_LPA=0
EXPECTED_CTC_LPA=0
EXPERIENCE_YEARS=0
NOTICE_PERIOD_MONTHS=1
